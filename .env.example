# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.

# Public address of the site (used for sitemap, social previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where form submissions are stored. Local file by default.
# For hosting without a persistent disk, use a hosted libSQL / Turso database instead:
#   DATABASE_URL=libsql://your-db.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/central-fostering.db

# Email notification to the agency when someone submits a form.
# Leave SMTP_HOST empty to skip emails (submissions are still saved).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Central Fostering <no-reply@your-domain>"
NOTIFY_EMAIL_TO=
